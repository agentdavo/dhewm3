+/* GL_EXT_depth_bounds_test: a pure state-setter implemented by the softgles2
+ * backend (sgl2_glDepthBoundsEXT, resolved at the final engine link), with no
+ * gl4es wrapper of its own. The engine's PFNGLDEPTHBOUNDSEXTPROC passes GLclampd
+ * (double); softgles2 takes float, so bridge the ABI here. glEnable(GL_DEPTH_
+ * BOUNDS_TEST_EXT) still routes through gl4es's normal enable passthrough. */
+extern void sgl2_glDepthBoundsEXT(float zmin, float zmax);
+static void gl4es_glDepthBoundsEXT_shim(double zmin, double zmax) {
+    sgl2_glDepthBoundsEXT((float)zmin, (float)zmax);
+}
+
 void* APIENTRY_GL4ES gl4es_GetProcAddress(const char *name) {
     DBG(printf("glGetProcAddress(\"%s\")", name);)
+    if (name && !strcmp(name, "glDepthBoundsEXT"))
+        return (void *)gl4es_glDepthBoundsEXT_shim;
     // generated gles wrappers
     #include "glesfuncs.inc"
 
