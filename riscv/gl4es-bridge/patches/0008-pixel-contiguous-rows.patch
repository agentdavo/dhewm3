+/* Typed contiguous indexing exposes the four-byte pixel layout to GCC.
+ * Do not promise disjoint buffers: preserve forward-loop overlap semantics. */
+static void pixel_swap_rb_row(const GLuint *in, GLuint *out, GLuint width)
+{
+    for (GLuint j = 0; j < width; ++j) {
+        const GLuint tmp = in[j];
+#ifdef __BIG_ENDIAN__
+        out[j] = (tmp&0x00ff00ff) | ((tmp&0x0000ff00)<<16) | ((tmp&0xff000000)>>16);
+#else
+        out[j] = (tmp&0xff00ff00) | ((tmp&0x00ff0000)>>16) | ((tmp&0x000000ff)<<16);
+#endif
+    }
+}
