# bare-metal RISC-V build artifacts (top-level and per-subproject build dirs)
/riscv/build/
/riscv/**/build/
*.img
*.ppm
/riscv/gl4es/

# game assets (copyrighted) staged for the disk image, not source
base/*.pk4
# mkimage.sh build staging (copies of base/ assets; regenerable, not source)
/riscv/image/staging/
*:Zone.Identifier

# raw reference specs (analysis lives in riscv/docs/spec/)
/gles2.txt
/riscv/docs/*.pdf
/riscv/audio/miniaudio.h
/riscv/sdl3/
# stamped rv64 ELF payloads (build artifacts; regenerate with: cmake --build build-rv --target dist)
/riscv/dist/
/riscv/glmark2/build-cmake-doomos

